# This is the base Dockerfile for a monorepo using Yarn 4 with Plug'n'Play (PnP).
# It sets up the necessary environment and installs dependencies for all workspaces.
# It can be used as a builder stage for other Dockerfiles.
# before_script: docker build -f Dockerfile.base -t lucky-monorepo-base .
# you should run this command to build the base image before building this Dockerfile.

# Use the official Node.js 20 image as the base image. because it is the latest LTS version.
FROM node:20-bullseye-slim

#  修复 Node.js 20+ OpenSSL 3.0 与 Google Auth 兼容性问题
ENV NODE_OPTIONS="--openssl-legacy-provider"

WORKDIR /app

# 构建原生模块所需工具 (sharp, bcrypt 等)
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ openssl procps \
    && rm -rf /var/lib/apt/lists/*

# Enable and prepare Corepack with Yarn 4.9.2, because Node 20 comes with Corepack disabled by default
RUN corepack enable && corepack prepare yarn@4.9.2 --activate

# Docker 下关闭全局缓存，让 .yarn/cache 写入工作目录，layer 缓存才能命中
ENV YARN_ENABLE_GLOBAL_CACHE=0

# ---- 先拷贝依赖声明 (利用 Docker layer 缓存) ----
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn

# copy from workspaces
COPY apps/api/package.json ./apps/api/package.json
COPY apps/admin-next/package.json ./apps/admin-next/package.json
COPY apps/admin-blog/package.json ./apps/admin-blog/package.json
COPY apps/liveness-web/package.json ./apps/liveness-web/package.json

# copy from packages
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/eslint-config/package.json ./packages/eslint-config/package.json
COPY packages/typescript-config/package.json ./packages/typescript-config/package.json
COPY packages/config/package.json ./packages/config/package.json

# ---- 安装全部依赖 (这层被缓存，除非 lock 文件变了) ----
# 打印 yarn 版本，确保与 .yarnrc.yml 指定一致
RUN yarn -v && yarn --version
RUN yarn install
# 安装后再次打印 yarn 版本，确认无误
RUN yarn -v && yarn --version
