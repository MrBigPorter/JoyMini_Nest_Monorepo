# ==========================================
# API 开发环境 Dockerfile
# ==========================================
# 基于 base 镜像 (已包含 node + yarn + 全部依赖)
# 构建 base: docker build -f Dockerfile.base -t lucky-monorepo-base .

FROM lucky-monorepo-base

# Article not found 修复 Node.js 20+ OpenSSL 3.0 与 Google Auth 兼容性问题
ENV NODE_OPTIONS="--openssl-legacy-provider"

WORKDIR /app

# 安装 ffmpeg（用于视频 HLS 转码）
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# Dev 模式下源码通过 compose volume 挂载 (.:/app)
# 不需要 COPY 源码，避免浪费构建时间和镜像体积

EXPOSE 3000

CMD ["yarn", "workspace", "@lucky/api", "start:dev"]

