{
  "name": "@lucky/api",
  "private": true,
  "scripts": {
    "start:dev": "NODE_OPTIONS=--openssl-legacy-provider nest start --watch",
    "start:debug": "NODE_OPTIONS=--openssl-legacy-provider nest start --debug --watch",
    "start:prod": "NODE_OPTIONS=--openssl-legacy-provider node dist/main",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --forceExit",
    "prestart:dev": "prisma generate --schema prisma/schema.prisma",
    "build": "nest build",
    "start": "NODE_OPTIONS=--openssl-legacy-provider node dist/main.js",
    "clean": "rimraf dist",
    "generate": "nest g",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 2000",
    "lint:fix": "eslint src --fix --max-warnings 2000",
    "pr:fmt": "prisma format",
    "pr:val": "prisma validate",
    "pr:dev": "prisma migrate dev",
    "pr:deploy": "prisma migrate deploy",
    "codes:gen": "node scripts/gen-error-codes.mjs",
    "prebuild": "node scripts/gen-error-codes.mjs",
    "seed": "tsx scripts/seed/run-seed.ts",
    "seed:treasures": "tsx scripts/seed/seed-treasures.ts",
    "seed:blog": "tsx scripts/seed/seed-blog-categories-tags.ts",
    "create-admin": "tsx scripts/cli/create-admin.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "export:swagger": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register scripts/cli/export-swagger.ts",
    "export:swagger:full": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register scripts/cli/export-swagger.ts --full --output ../../apps/swagger-docs"
  },
  "prisma": {
    "seed": "tsx scripts/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.956.0",
