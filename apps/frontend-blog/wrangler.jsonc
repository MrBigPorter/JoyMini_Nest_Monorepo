{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lucky-blog-prod",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "routes": [
    {
      "pattern": "blog.joyminis.com/*",
      "zone_name": "joyminis.com"
    },
    {
      "pattern": "blog-dev.joyminis.com/*",
      "zone_name": "joyminis.com"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "NODE_ENV": "production",
    "NEXT_PUBLIC_ENVIRONMENT": "cloudflare",
    "NEXT_PUBLIC_API_BASE_URL": "https://api.joyminis.com/api",
    "NEXT_PUBLIC_OAUTH_API_ORIGIN": "https://api.joyminis.com",
    "ENABLE_ISR": "true",
    "ENABLE_STREAMING": "true",
    "ENABLE_EDGE_MIDDLEWARE": "true",
    "AUTH_COOKIE_DOMAIN": ".joyminis.com",
    "NEXT_PUBLIC_BLOG_ENV": "production",
    "ISR_REVALIDATE_SECONDS": "60",
    "BROWSER_CACHE_TTL": "300",
    "STALE_WHILE_REVALIDATE": "86400"
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "e984df0553f24241850af22d7621faa4",
      "preview_id": "e984df0553f24241850af22d7621faa4"
    },
    {
      "binding": "ISR_CACHE",
      "id": "1fc88f516bcf4efa9a50bef6e2912405",
      "preview_id": "1fc88f516bcf4efa9a50bef6e2912405"
    },
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "1fc88f516bcf4efa9a50bef6e2912405",
      "preview_id": "1fc88f516bcf4efa9a50bef6e2912405"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_STORAGE",
      "bucket_name": "mini-shop",
      "preview_bucket_name": "mini-shop"
    }
  ],
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "joymin_blog_analytics"
    }
  ],
  "env": {
    "production": {
      "name": "lucky-blog-production",
      "compatibility_date": "2026-03-20",
      "vars": {
        "NEXT_PUBLIC_API_URL": "https://api.joyminis.com",
        "NEXT_PUBLIC_CDN_URL": "https://img.joyminis.com"
      }
    },
    "staging": {
      "name": "lucky-blog-staging",
      "compatibility_date": "2026-03-20",
      "vars": {
        "NEXT_PUBLIC_API_URL": "https://staging-api.joyminis.com",
        "NEXT_PUBLIC_CDN_URL": "https://staging-img.joyminis.com"
      }
    }
  }
}
