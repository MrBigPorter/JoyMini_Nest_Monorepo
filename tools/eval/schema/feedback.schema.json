{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joymini.local/eval/feedback.schema.json",
  "title": "EvalFeedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "turn",
    "key",
    "scoreType",
    "source",
    "evaluatorVersion"
  ],
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "turn": { "type": "integer", "minimum": 1 },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "scoreType": {
      "type": "string",
      "enum": ["boolean", "categorical", "continuous"]
    },
    "score": { "type": "number" },
    "value": { "type": "string", "maxLength": 200 },
    "comment": { "type": "string", "maxLength": 200 },
    "source": {
      "type": "string",
      "enum": ["CODE", "LLM", "HUMAN"]
    },
    "evaluatorVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "judgeVersion": { "type": ["string", "null"], "maxLength": 200 },
    "runId": { "type": "string", "maxLength": 100 }
  }
}
