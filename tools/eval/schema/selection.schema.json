{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joymini.local/eval/selection.schema.json",
  "title": "EvalConversationSelection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "datasetVersion",
    "conversationId",
    "source",
    "language",
    "intent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "conversationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source": {
      "type": "string",
      "enum": ["real", "sim", "drill"]
    },
    "language": {
      "type": "string",
      "enum": ["zh", "en", "mixed"]
    },
    "intent": {
      "type": "string",
      "enum": [
        "order",
        "wallet",
        "coupon",
        "product",
        "user",
        "kyc",
        "lucky",
        "rag",
        "general"
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "note": { "type": "string", "maxLength": 500 }
  }
}
